# Qdrant: use the local service from compose.yaml or your own hosted instance.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=markdown_knowledge

# Production embeddings. Offline `ingest` does not read or require this key.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
